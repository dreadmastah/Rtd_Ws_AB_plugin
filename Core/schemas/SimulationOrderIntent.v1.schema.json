{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:astu:SimulationOrderIntent.v1",
  "title": "SimulationOrderIntent.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "messageType",
    "simulationOrderId",
    "requestId",
    "idempotencyKey",
    "signalId",
    "symbol",
    "action",
    "side",
    "quantity",
    "referencePrice",
    "notional",
    "simulationOnly",
    "orderRoutingEnabled",
    "exchangeSubmissionAttempted"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "messageType": {"const": "SimulationOrderIntent.v1"},
    "simulationOrderId": {"type": "string", "minLength": 1, "maxLength": 64},
    "requestId": {"type": "string", "minLength": 1, "maxLength": 128},
    "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 128},
    "signalId": {"type": "string", "minLength": 1, "maxLength": 128},
    "symbol": {"type": "string", "minLength": 1, "maxLength": 32},
    "action": {"enum": ["BUY", "SELL", "SCALE_IN", "SCALE_OUT"]},
    "side": {"enum": ["LONG", "SHORT"]},
    "quantity": {"type": "number", "exclusiveMinimum": 0},
    "referencePrice": {"type": "number", "exclusiveMinimum": 0},
    "notional": {"type": "number", "exclusiveMinimum": 0},
    "simulationOnly": {"const": true},
    "orderRoutingEnabled": {"const": false},
    "exchangeSubmissionAttempted": {"const": false}
  }
}
