{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:astu:DemoExecutionRequest.v1",
  "title": "DemoExecutionRequest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "messageType",
    "requestId",
    "idempotencyKey",
    "sourceSimulationOrderId",
    "signalId",
    "symbol",
    "side",
    "quantity",
    "reduceOnly",
    "createdUnixMs",
    "expiresUnixMs",
    "capabilityId",
    "capabilityToken",
    "executionEnvironment"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "messageType": {"const": "DemoExecutionRequest.v1"},
    "requestId": {"type": "string", "minLength": 1, "maxLength": 128},
    "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 128},
    "sourceSimulationOrderId": {"type": "string", "minLength": 1, "maxLength": 64},
    "signalId": {"type": "string", "minLength": 1, "maxLength": 128},
    "symbol": {"type": "string", "minLength": 1, "maxLength": 32},
    "side": {"enum": ["LONG", "SHORT"]},
    "quantity": {"type": "number", "exclusiveMinimum": 0},
    "reduceOnly": {"type": "boolean"},
    "createdUnixMs": {"type": "integer", "minimum": 1},
    "expiresUnixMs": {"type": "integer", "minimum": 1},
    "capabilityId": {"type": "string", "minLength": 1, "maxLength": 128},
    "capabilityToken": {"type": "string", "minLength": 32, "maxLength": 256},
    "executionEnvironment": {"const": "BINANCE_USDM_DEMO"}
  }
}
