{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:astu:RuntimeDataStatus.v1",
  "title": "RuntimeDataStatus.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "symbol",
    "generatedUnixMs",
    "live",
    "fresh",
    "cacheReady",
    "identityReady",
    "universeId",
    "universeVersion",
    "universeHash",
    "dataGeneration",
    "generationKind",
    "cacheEod",
    "cacheIntraday",
    "quoteAgeMs",
    "detail"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "source": {"const": "WSRTD-CleanRoomR2"},
    "symbol": {"type": "string", "minLength": 1, "maxLength": 32},
    "generatedUnixMs": {"type": "integer", "minimum": 1},
    "live": {"type": "boolean"},
    "fresh": {"type": "boolean"},
    "cacheReady": {"type": "boolean"},
    "identityReady": {"type": "boolean"},
    "universeId": {"type": "string", "maxLength": 128},
    "universeVersion": {"type": "integer", "minimum": 0},
    "universeHash": {"type": "string", "maxLength": 64},
    "dataGeneration": {"type": "integer", "minimum": 0},
    "generationKind": {"type": "string", "maxLength": 64},
    "cacheEod": {"type": "integer", "minimum": 0},
    "cacheIntraday": {"type": "integer", "minimum": 0},
    "quoteAgeMs": {"type": "integer", "minimum": 0},
    "detail": {"type": "string", "maxLength": 512}
  }
}
