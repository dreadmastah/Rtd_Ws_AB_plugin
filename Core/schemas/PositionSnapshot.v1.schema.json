{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:astu:PositionSnapshot.v1",
  "title": "PositionSnapshot.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "messageType",
    "generatedUnixMs",
    "source",
    "reconciled",
    "symbol",
    "mode",
    "quantity",
    "notional",
    "detail"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "messageType": {"const": "PositionSnapshot.v1"},
    "generatedUnixMs": {"type": "integer", "minimum": 1},
    "source": {"type": "string", "minLength": 1, "maxLength": 128},
    "reconciled": {"type": "boolean"},
    "symbol": {"type": "string", "minLength": 1, "maxLength": 32},
    "mode": {"enum": ["FLAT", "LONG", "SHORT", "HEDGED", "UNKNOWN"]},
    "quantity": {"type": "number", "minimum": 0},
    "notional": {"type": "number", "minimum": 0},
    "detail": {"type": "string", "maxLength": 512}
  }
}
