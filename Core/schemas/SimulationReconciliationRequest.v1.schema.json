{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:astu:SimulationReconciliationRequest.v1",
  "title": "SimulationReconciliationRequest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "messageType",
    "requestId",
    "eventId",
    "simulationOrderId",
    "reconciliationType",
    "cumulativeFilledQuantity",
    "detail"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "messageType": {"const": "SimulationReconciliationRequest.v1"},
    "requestId": {"type": "string", "minLength": 1, "maxLength": 128},
    "eventId": {"type": "string", "minLength": 1, "maxLength": 128},
    "simulationOrderId": {"type": "string", "minLength": 1, "maxLength": 64},
    "reconciliationType": {
      "enum": [
        "MARK_UNKNOWN",
        "ACKNOWLEDGED",
        "WORKING",
        "PARTIAL_FILL",
        "FILLED",
        "CANCELED",
        "REJECTED"
      ]
    },
    "cumulativeFilledQuantity": {"type": "number", "minimum": 0},
    "detail": {"type": "string", "maxLength": 512}
  }
}
