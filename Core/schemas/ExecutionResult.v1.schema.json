{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:astu:ExecutionResult.v1",
  "title": "ExecutionResult.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "messageType",
    "requestId",
    "signalId",
    "simulationOrderId",
    "decisionCode",
    "acceptedForSimulation",
    "wouldIncreaseExposure",
    "simulatedQuantity",
    "simulatedNotional",
    "orderRoutingEnabled",
    "executionEnvironment",
    "exchangeClientOrderId",
    "exchangeOrderId",
    "exchangeOrderStatus",
    "reason"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "messageType": {
      "const": "ExecutionResult.v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "signalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "decisionCode": {
      "enum": [
        "SIMULATED_ACCEPTED",
        "INVALID_INTENT",
        "DATA_NOT_READY",
        "IDENTITY_UNAVAILABLE",
        "UNIVERSE_MISMATCH",
        "DATA_GENERATION_MISMATCH",
        "NOT_YET_VALID",
        "EXPIRED",
        "ACCOUNT_NOT_RECONCILED",
        "RISK_BLOCKED",
        "INSTRUMENT_UNAVAILABLE",
        "FILTER_REJECTED",
        "SIZING_REJECTED",
        "POSITION_UNAVAILABLE",
        "POSITION_CONFLICT",
        "TESTNET_SUBMITTED",
        "TESTNET_REJECTED",
        "TESTNET_UNKNOWN",
        "ORDER_ROUTING_DISABLED",
        "DUPLICATE_REQUEST",
        "FRAME_INVALID"
      ]
    },
    "acceptedForSimulation": {
      "type": "boolean"
    },
    "wouldIncreaseExposure": {
      "type": "boolean"
    },
    "simulatedQuantity": {
      "type": "number",
      "minimum": 0
    },
    "simulatedNotional": {
      "type": "number",
      "minimum": 0
    },
    "orderRoutingEnabled": {
      "type": "boolean"
    },
    "reason": {
      "type": "string",
      "maxLength": 512
    },
    "simulationOrderId": {
      "type": "string",
      "maxLength": 64
    },
    "executionEnvironment": {
      "enum": [
        "SIMULATION_ONLY",
        "BINANCE_USDM_TESTNET"
      ]
    },
    "exchangeClientOrderId": {
      "type": "string",
      "maxLength": 36
    },
    "exchangeOrderId": {
      "type": "string",
      "maxLength": 64
    },
    "exchangeOrderStatus": {
      "type": "string",
      "maxLength": 64
    }
  }
}
